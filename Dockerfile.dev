# syntax = docker/dockerfile:1
#
# Local dev image for the `webapp`/`worker` services in docker-compose.yml.
# NOT used for production — see webapp/Dockerfile and
# packages/worker/Dockerfile for those multi-stage builds.
#
# node:${NODE_VERSION}-slim doesn't ship Python or a C/C++ toolchain, which
# some native optional deps (e.g. msgpackr-extract, pulled in transitively
# via bullmq's msgpackr dependency) need in order to compile from source
# when no prebuilt binary is available for the platform. The production
# Dockerfiles already install these; this mirrors that install step so
# local dev doesn't hit a "node-gyp ... Python not found" error during
# `pnpm install`.
#
# No source is COPY'd here — docker-compose.yml bind-mounts the whole repo
# into /app at runtime, and `pnpm install` itself runs as part of each
# service's `command:`, same as before this file existed.
ARG NODE_VERSION=22.23.2
FROM node:${NODE_VERSION}-slim

# curl is pulled in for the webapp service's own healthcheck (see
# docker-compose.yml) — lets `docker compose up --wait` actually wait for
# `pnpm install` + the dev server to be ready, not just for the container
# process to have started. xz-utils is only for unpacking the Typst
# release tarball just below.
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y build-essential node-gyp pkg-config python-is-python3 curl xz-utils ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# The letter PDF (worker service) compiles with Typst — a single static
# binary, no shared-library dependencies, so a plain download+extract is
# the whole install (contrast `crates/heic-decode`, which actually
# compiles; see `packages/worker/Dockerfile`'s own Typst stage for
# production's copy of this same download). Pinned to the same version
# as `packages/worker/Dockerfile` — bump both together.
ARG TYPST_VERSION=0.15.1
RUN curl -fsSL "https://github.com/typst/typst/releases/download/v${TYPST_VERSION}/typst-x86_64-unknown-linux-musl.tar.xz" \
      -o /tmp/typst.tar.xz && \
    tar -xJf /tmp/typst.tar.xz -C /tmp && \
    mv "/tmp/typst-x86_64-unknown-linux-musl/typst" /usr/local/bin/typst && \
    rm -rf /tmp/typst.tar.xz "/tmp/typst-x86_64-unknown-linux-musl"

RUN corepack enable pnpm

# The services run as the host user, not root (bin/dev-as-host-user.sh),
# and that uid may have no home in this image (501 on a Mac). Give
# corepack (which downloads pnpm on first use) and pnpm's own caches a
# home any uid can write to.
ENV HOME=/home/dev COREPACK_HOME=/opt/corepack
RUN mkdir -p /home/dev /opt/corepack && chmod 1777 /home/dev /opt/corepack

WORKDIR /app
