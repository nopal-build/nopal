# Cargo build output (also covered by the repo-root .gitignore's own
# `target/` pattern; listed here too so this workspace is self-
# documenting on its own).
/target/

# wasm-bindgen's generated JS glue + .wasm binary — regenerated by the
# exact commands documented in each crate's own README, not source to
# track. Keeping these out avoids committing multi-megabyte binaries
# that go stale the moment the source they were built from changes.
**/web/pkg/
crates/oxmarkdown-leptos/ssr-pkg/

# e2e (Playwright) — installed packages and throwaway run artifacts, not
# source. `e2e/package.json`/`playwright.config.ts`/`tests/*.spec.ts` ARE
# tracked.
e2e/node_modules/
e2e/test-results/
e2e/playwright-report/
