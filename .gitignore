# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Javascript Ignores
node_modules
remix/build
.cache/
build/
.pnpm-store/

# React Router's generated type-checking cache (`react-router typegen`,
# run automatically by dev/build/typecheck) — entirely derived from
# app/routes/, never hand-edited, same category as .next/.svelte-kit/.
webapp/.react-router/

# Playwright screenshots from webapp/scripts/visual-check.ts
webapp/tmp/

# Environment variables
.env

# Mac Ignores
.DS_Store

# GraphLog load-bearing decision records — reasoning is worth keeping
# locally, but the repo is public and a one-line "brake, not a default"
# code comment is enough to point at these without publishing the
# reasoning itself. See docs/adr/0001-nodes-are-permanent-and-verbatim.md
# and its siblings.
docs/adr/

# Temporary files
tmp/
