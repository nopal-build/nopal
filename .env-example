# The ONE .env for local dev — read by docker-compose.yml (its ${VAR}
# interpolation only ever looks at a .env file sitting next to it, here at
# the repo root) AND, for anyone running webapp/fruits/the worker directly
# on the host instead of in Docker, by Vite's own .env loading (each of
# webapp/vite.config.js, fruits/vite.config.js and
# packages/worker/vite.config.ts sets envDir back to the repo root so none
# of them need -- or silently fall out of sync with -- their own copy).
#
# Not all vars below apply to every service (see the per-section notes),
# but there's deliberately only one file: copy this to `.env` and fill in
# what you need. Production never reads this file at all -- each Fly app
# (webapp, fruits, worker) gets its secrets from `fly secrets set`
# independently (see fruits/scripts/copy-secrets-from-webapp.sh for the
# one-time bootstrap between them).
#
# Running the stack via `make dev` / docker compose instead? Every var
# below has a working default baked into docker-compose.yml, so an empty
# .env still brings the stack up -- fill in only what the feature you're
# touching needs, then `make restart` (containers read env once, at start).

DATABASE_URL=http://localhost:8080/rpc
DATABASE_USERNAME=root
DATABASE_PASSWORD=root
RESEND_API_KEY=
ENCRYPTION_SECRET=
SESSION_SECRET=# 64 bit hex

# WebAuthn (passkey) RP ID / allowed origins -- see auth/webauthn.server.ts
# and docs/marketing-app-split-plan.md's "Critical risks" #1. Leave unset
# for local dev / any single-hostname deployment (derived from the request
# instead). Only needed once the app is reachable from more than one
# hostname sharing a registrable domain (e.g. nopal.build AND
# o.nopal.build).
WEBAUTHN_RP_ID=
WEBAUTHN_ALLOWED_ORIGINS=# comma-separated, e.g. https://nopal.build,https://o.nopal.build

# Session cookie domain -- see auth/session.server.ts. Leave unset for
# exact-host-only cookies (today's behavior). Only needed if login and the
# app end up on different subdomains that must share one session.
SESSION_COOKIE_DOMAIN=

# The app service's own public URL (o.nopal.build) -- webapp no longer
# serves login/vault/etc itself (see docs/marketing-app-split-plan.md), but
# a couple of marketing pages still need to link INTO the app (the "Log
# in" footer link, the WC waiver admin-notification email's legal-
# document link). Defaults to the prod app URL if unset.
APP_BASE_URL=https://o.nopal.build

# webapp (marketing) only -- fruits has no use for these (see
# fruits/scripts/copy-secrets-from-webapp.sh's own "deliberately NOT
# copied" note).
NOTION_TOKEN=
NOTION_WEBHOOK_SECRET=
DISCORD_BOT_TOKEN=your-bot-token-here
DISCORD_CHANNEL_ID=your-channel-id
WEBSITE_PROJECT_FOLDER_ID=

# --- S3 / object storage (see file.server.ts's own header comment) --------
# Local (docker compose / MinIO): path-style, reachable from the browser at
# localhost:9000. Prod (Tigris): virtual-hosted style, no path style flag.
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_HOSTNAME=localhost:9000
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
BUCKET_NAME=local-bucket

ANTHROPIC_API_KEY=
# Only required for an API key that is NOT pinned to exactly one
# workspace at creation (see anthropicProvider.server.ts) -- e.g. a
# Personal/service-account key scoped to "all workspaces you have
# access to". Find it on the Console under Settings -> Workspaces
# (wrkspc_... id). Leave unset for a key genuinely scoped to one
# workspace (legacy Workspace keys, or Personal/service-account pinned
# to a single non-Default workspace).
ANTHROPIC_WORKSPACE_ID=

# PhyLog's job queue (see the `phylog` skill's "Scaling & Process
# Isolation" section). docker-compose.yml overrides this to the `redis`
# service's address automatically — only needed here for running
# `npm run dev`/`npm run worker` directly on the host.
REDIS_URL=redis://localhost:6379

# fruits only -- protects server.js's own daily cron endpoints
# (/api/vault/archive-cleanup, /api/vault/trash-cleanup,
# /api/daily-log/sort-all, /api/billing/pause-check,
# /api/performance/prune, /api/graphlog/scheduled-run). Required for
# those routes to do anything; see any one of them for the
# `fly secrets set CRON_SECRET=$(openssl rand -hex 32)` example.
CRON_SECRET=

# fruits only -- dictation's realtime transcription relay
# (fruits/dictation/relay.js). Leave unset to disable dictation locally.
SONIOX_API_KEY=

# --- Stripe (fruits only -- Payments: /pay/*, plans, /api/stripe/webhook) --
# Test keys come from the O.No Stripe *sandbox* (not legacy test mode); the
# O.No prices live there. Get the sk/pk out of the password manager.
STRIPE_SECRET_KEY=          # sk_test_...  (sandbox)
STRIPE_PUBLISHABLE_KEY=     # pk_test_...  (sandbox)
# Signing secret for webhook events. Locally it's per-developer: run
#   stripe listen --forward-to localhost:3001/api/stripe/webhook
# and paste the whsec_... it prints. It stays the same for that CLI login.
# Production uses a different one, from the endpoint created in the Stripe
# dashboard, set as a Fly secret, never in this file.
# Unset = the webhook route rejects every event (and logs why).
STRIPE_WEBHOOK_SECRET=      # whsec_...

# --- docker-compose-only overrides (defaults shown; leave unset normally) -
# These configure credentials BETWEEN containers (db <-> webapp/fruits/
# worker, minio <-> webapp/fruits/worker) when running via `make dev` /
# docker compose -- they have no effect when running directly on the host
# (use DATABASE_USERNAME/PASSWORD and AWS_ACCESS_KEY_ID/SECRET above
# instead). HOST_UID/HOST_GID are set by the Makefile; don't set them here.
# SURREAL_USER=root
# SURREAL_PASS=root
# APP_USER=root
# APP_PASS=root
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
# TYPST_BIN=typst
