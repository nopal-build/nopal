# Root .env for the dev stack (`make dev` / docker compose).
#
# Copy to `.env` at the repo root. docker-compose.yml interpolates these
# into the containers; nothing here is read by an app directly. Every
# variable has a working default or is optional, so an empty .env still
# brings the stack up -- fill in only what the feature you're touching needs.
#
# This is not webapp/.env-example: that file is for running webapp or the
# worker straight on the host. Values set only there never reach the
# fruits container, which is where payments runs.
#
# After any change: `make restart` (containers read env once, at start).

# --- Stripe (payments: /pay/*, plans, /api/stripe/webhook) ---------------
# Test keys come from the O.No Stripe *sandbox* (not legacy test mode); the
# O.No prices live there. Get the sk/pk out of the password manager.
STRIPE_SECRET_KEY=          # sk_test_...  (sandbox)
STRIPE_PUBLISHABLE_KEY=     # pk_test_...  (sandbox)
# Signing secret for webhook events. Locally it's per-developer: run
#   stripe listen --forward-to localhost:3001/api/stripe/webhook
# and paste the whsec_... it prints. It stays the same for that CLI login.
# Production uses a different one, from the endpoint created in the Stripe
# dashboard, set as a Fly secret, never in this file.
# Unset = the webhook route rejects every event (and logs why).
STRIPE_WEBHOOK_SECRET=      # whsec_...

# --- Model keys ------------------------------------------------------------
# GraphLog stages on the worker (e.g. a letter's brief). Empty = the stage
# says GraphLog isn't configured.
ANTHROPIC_API_KEY=
# Dictation (docker-compose.override.yml). Empty = dictate never starts.
SONIOX_API_KEY=

# --- Optional overrides (defaults shown; leave unset normally) ------------
# SURREAL_USER=root
# SURREAL_PASS=root
# APP_USER=root
# APP_PASS=root
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
# BUCKET_NAME=local-bucket
# TYPST_BIN=typst
# HOST_UID / HOST_GID are set by the Makefile; don't set them here.
